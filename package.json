{
  "name": "yen-study-desk",
  "productName": "yeN",
  "version": "0.8.0",
  "private": true,
  "description": "本地学习工作台：笔记、任务、目标与日程",
  "author": "yeN个人项目",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/build.cjs && electron .",
    "build": "node scripts/build.cjs",
    "test:storage": "node --test tests/storage.test.cjs tests/export.test.cjs",
    "test:desktop": "node tests/desktop.test.cjs",
    "test:tray": "node tests/tray.test.cjs",
    "package": "node scripts/build.cjs && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1",
    "prettier": "3.8.3"
  },
  "build": {
    "appId": "app.yen.study",
    "productName": "yeN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "yeN",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "artifactName": "yeN-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "yeN-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Duuuuiiii",
      "repo": "yeN",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "music-metadata": "^11.16.1"
  }
}
